# Copiar a .env.local y completar. Nunca commitear .env.local.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # antes "anon key"
SUPABASE_URL=                           # mismo valor, para jobs fuera de Next.js
SUPABASE_SECRET_KEY=                    # antes "service_role". Solo servidor y jobs.

# DataForSEO (https://app.dataforseo.com/api-access). Vacío = dry-run con fixtures.
DFS_LOGIN=
DFS_PASSWORD=

# Google CrUX API (Fase 5)
CRUX_API_KEY=

# Public URL of the portal (magic link redirect, snippet endpoint). Production: the Netlify URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Speed snippet (Phase 4)
# Share of visits the snippet measures, 0 to 1.
NEXT_PUBLIC_SNIPPET_SAMPLE_RATE=1
# Extra exact origins allowed to send events, comma separated (development only), e.g. http://localhost:3000
INGEST_EXTRA_ORIGINS=
