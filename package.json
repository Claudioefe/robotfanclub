{
  "name": "robot-fan-club",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "seed:demo": "node --env-file=.env.local scripts/seed-demo.mjs",
    "grant-access": "node --env-file=.env.local scripts/grant-access.mjs",
    "watcher:dry-run": "node --env-file=.env.local jobs/watcher/cli.ts --mode dry-run",
    "create-client": "node --env-file=.env.local scripts/create-client.mjs",
    "crux:dry-run": "node --env-file=.env.local jobs/crux/cli.ts --mode dry-run",
    "crux:live": "node --env-file=.env.local jobs/crux/cli.ts --mode live",
    "crux:backfill": "node --env-file=.env.local jobs/crux/cli.ts --mode live --backfill",
    "add-crux-target": "node --env-file=.env.local scripts/add-crux-target.mjs",
    "ai-visibility:dry-run": "node --env-file=.env.local jobs/ai-visibility/cli.ts --mode dry-run",
    "load-real-mentions": "node --no-warnings --env-file=.env.local scripts/load-real-mentions.mjs",
    "load-real-sample": "node --no-warnings --env-file=.env.local scripts/load-real-sample.mjs",
    "mcp": "node --no-warnings --env-file=.env.local mcp/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
